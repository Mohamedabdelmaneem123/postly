rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- Helper functions --
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user is a member of a specific company
    function isMember(companyId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/companies/$(companyId)/team/$(request.auth.uid));
    }
    
    // Get the user's role in a company
    function getRole(companyId) {
       return get(/databases/$(database)/documents/companies/$(companyId)/team/$(request.auth.uid)).data.role;
    }
    
    function isOwner(companyId) {
      return isMember(companyId) && getRole(companyId) == 'Owner';
    }

    function isAdmin(companyId) {
      return isMember(companyId) && (getRole(companyId) == 'Owner' || getRole(companyId) == 'Admin');
    }

    // -- User Profiles --
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // -- Companies --
    match /companies/{companyId} {
      // Any authenticated user can create a company
      allow create: if isAuthenticated();
      
      // Only members can read the company details
      allow read: if isMember(companyId);
      
      // Only owners/admins can update
      allow update: if isAdmin(companyId);
      allow delete: if isOwner(companyId);

      // Company-Scoped Subcollections
      
      // Team Membership
      match /team/{userId} {
        allow read: if isMember(companyId);
        allow write: if isAdmin(companyId);
      }
      
      // Scheduled Posts
      match /scheduled_posts/{postId} {
        allow read: if isMember(companyId);
        allow create, update, delete: if isMember(companyId); // Future: Restrict based on role if needed
      }
      
      // Media Library
      match /media_library/{mediaId} {
        allow read: if isMember(companyId);
        allow create, update, delete: if isMember(companyId);
      }
      
      // Analytics
      match /analytics/{postId} {
        allow read: if isMember(companyId);
        // Writing analytics is typically done via a service account (Cloud Function)
        allow write: if false; 
      }
    }
    
    // -- Collection Group Queries (required for getUserCompanies) --
    match /{path=**}/team/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
    }

    // -- AI Usage (System Global for Tracking) --
    match /ai_usage/{usageId} {
      allow read, write: if isAuthenticated(); // Usage tracking is cross-company
    }

    // -- Secure Token Vault --
    // Only the backend Node.js worker (Firebase Admin SDK) can read/write here.
    match /vault_social_tokens/{tokenId} {
      allow read, write: if false; 
    }
  }
}
