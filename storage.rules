rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Companies folder: companies/{companyId}/media/{fileId}
    match /companies/{companyId}/{allPaths=**} {
      // Basic check for MVP: must be logged in. 
      // For higher security, cross-check with Firestore:
      // allow read, write: if isAuthenticated() && firestore.exists(/databases/(default)/documents/company_members/$(request.auth.uid) + '_' + companyId);
      allow read, write: if isAuthenticated();
    }
  }
}
